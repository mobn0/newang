# Mock-site image: builds newang + the showcase app, serves the static
# bundle with nginx (SPA fallback so /dashboard etc. load directly).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build -- --configuration production \
 && npx ng build showcase --configuration production

FROM nginx:alpine
COPY e2e/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/showcase/browser /usr/share/nginx/html
EXPOSE 80
